---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getTranslations, getDateLocale } from "../../../i18n/index";

const locale = "es";
const t = getTranslations(locale);

const posts = await getCollection("blog", ({ data }) => {
  return (data as any).locale === "es";
});
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const dateLocale = getDateLocale(locale);

function formatDate(date: Date): string {
  return date.toLocaleDateString(dateLocale, {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title={t.meta.blogTitle}
  description={t.blog.description}
  locale="es"
>
  <header
    class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-xl border-b border-border"
  >
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a
        href="/es"
        class="font-mono text-lg tracking-wider text-primary transition-colors hover:text-foreground"
      >
        {"^["}
      </a>
      <a
        href="/es"
        class="flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        {t.blog.backToHome}
      </a>
    </nav>
  </header>

  <main class="pt-24 pb-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-16">
        <p class="mb-2 font-mono text-sm text-primary animate-fade-in">
          // blog
        </p>
        <h1
          class="text-4xl font-bold text-foreground sm:text-5xl animate-fade-in-up"
          style="animation-delay: 100ms"
        >
          {t.blog.allPosts}
        </h1>
        <p
          class="mt-4 max-w-2xl text-lg text-muted-foreground animate-fade-in-up"
          style="animation-delay: 200ms"
        >
          {t.blog.description}
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          sortedPosts.map((post, index) => (
            <article
              class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 animate-fade-in-up"
              style={`animation-delay: ${(index + 1) * 100}ms`}
            >
              <div class="flex flex-1 flex-col p-6">
                <div class="mb-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag: string) => (
                    <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                      {tag}
                    </span>
                  ))}
                </div>

                <h2 class="mb-2 text-xl font-semibold text-foreground transition-colors group-hover:text-primary">
                  <a
                    href={`/es/blog/${post.id}`}
                    class="after:absolute after:inset-0"
                  >
                    {post.data.title}
                  </a>
                </h2>

                <p class="mb-4 flex-1 text-sm leading-relaxed text-muted-foreground">
                  {post.data.excerpt}
                </p>

                <div class="flex items-center gap-4 text-xs text-muted-foreground">
                  <span class="flex items-center gap-1">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <rect width="18" height="18" x="3" y="4" rx="2" />
                      <path d="M3 10h18" />
                    </svg>
                    {formatDate(post.data.date)}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    {post.data.readTime}
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>

  <footer class="border-t border-border bg-card py-8">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <a
        href="/es"
        class="font-mono text-lg text-primary transition-colors hover:text-foreground"
      >
        {"^["}
      </a>
      <p class="mt-2 text-xs text-muted-foreground">
        {t.footer.allRights.replace("{year}", String(new Date().getFullYear()))}
      </p>
    </div>
  </footer>
</Layout>
