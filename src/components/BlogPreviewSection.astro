---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const latestPosts = posts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<section id="blog" class="py-24" aria-labelledby="blog-heading">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal class="mb-16">
      <p class="mb-2 font-mono text-sm text-primary">// latest posts</p>
      <h2
        id="blog-heading"
        class="text-3xl font-bold text-foreground sm:text-4xl"
      >
        From the Blog
      </h2>
      <p class="mt-4 max-w-2xl text-muted-foreground">
        Thoughts on development, design, and building better software.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        latestPosts.map((post, index) => (
          <article
            data-reveal
            data-reveal-delay={String((index + 1) * 100)}
            class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all duration-500 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5"
          >
            <div class="flex flex-1 flex-col p-6">
              <div class="mb-4 flex flex-wrap gap-2">
                {post.data.tags.slice(0, 2).map((tag: string) => (
                  <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                    {tag}
                  </span>
                ))}
              </div>

              <h3 class="mb-2 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
                <a
                  href={`/blog/${post.id}`}
                  class="after:absolute after:inset-0"
                >
                  {post.data.title}
                </a>
              </h3>

              <p class="mb-4 flex-1 text-sm leading-relaxed text-muted-foreground">
                {post.data.excerpt}
              </p>

              <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <span class="flex items-center gap-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M8 2v4" />
                    <path d="M16 2v4" />
                    <rect width="18" height="18" x="3" y="4" rx="2" />
                    <path d="M3 10h18" />
                  </svg>
                  {formatDate(post.data.date)}
                </span>
                <span class="flex items-center gap-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  {post.data.readTime}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div data-reveal data-reveal-delay="400" class="mt-12 text-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-lg border border-primary bg-primary/10 px-6 py-3 text-sm font-medium text-primary transition-all hover:bg-primary hover:text-primary-foreground"
      >
        View All Posts
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
