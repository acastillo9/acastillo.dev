---
import { socialLinks } from "../data/social";
import type { Translations } from "../i18n/index";

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const iconPaths: Record<string, string> = {
  GitHub:
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4M9 18c-4.51 2-5-2-7-2',
  LinkedIn:
    'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  Email: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6',
};
---

<section
  id="contact"
  class="px-6 py-28 lg:py-36"
  aria-labelledby="contact-heading"
>
  <div data-reveal class="mx-auto max-w-6xl">
    <div class="mb-16 max-w-2xl">
      <p class="mb-2 font-mono text-sm tracking-widest text-primary">
        {t.contact.label}
      </p>
      <h2
        id="contact-heading"
        class="text-balance text-3xl font-bold text-foreground sm:text-4xl"
      >
        {t.contact.heading}
      </h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        {t.contact.description}
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <!-- Contact Form -->
      <div class="lg:col-span-3">
        <div
          id="contact-success"
          class="hidden h-full min-h-[300px] items-center justify-center rounded-xl border border-primary/30 bg-primary/5"
        >
          <div class="text-center">
            <div
              class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
              </svg>
            </div>
            <p class="text-lg font-medium text-foreground">{t.contact.successTitle}</p>
            <p class="mt-1 text-sm text-muted-foreground">
              {t.contact.successMessage}
            </p>
          </div>
        </div>

        <form
          id="contact-form"
          class="space-y-6"
          data-sending-text={t.contact.sending}
          data-error-fields={t.contact.errors.FIELDS_REQUIRED}
          data-error-email={t.contact.errors.INVALID_EMAIL}
          data-error-long={t.contact.errors.MESSAGE_TOO_LONG}
          data-error-send={t.contact.errors.SEND_FAILED}
          data-error-server={t.contact.errors.SERVER_ERROR}
          data-error-unknown={t.contact.errors.UNKNOWN}
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label
                for="name"
                class="mb-2 block text-sm font-medium text-foreground"
              >
                {t.contact.nameLabel}
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder={t.contact.namePlaceholder}
                class="w-full rounded-lg border border-border bg-input px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>
            <div>
              <label
                for="email"
                class="mb-2 block text-sm font-medium text-foreground"
              >
                {t.contact.emailLabel}
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder={t.contact.emailPlaceholder}
                class="w-full rounded-lg border border-border bg-input px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>
          </div>
          <div>
            <label
              for="message"
              class="mb-2 block text-sm font-medium text-foreground"
            >
              {t.contact.messageLabel}
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder={t.contact.messagePlaceholder}
              class="w-full resize-none rounded-lg border border-border bg-input px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/50 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            ></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-all hover:brightness-110 hover:shadow-[0_0_24px_rgba(0,210,200,0.25)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m22 2-7 20-4-9-9-4Z"></path>
              <path d="M22 2 11 13"></path>
            </svg>
            {t.contact.send}
          </button>
        </form>
      </div>

      <!-- Social links -->
      <div class="flex flex-col justify-between gap-8 lg:col-span-2">
        <div>
          <h3 class="mb-4 font-mono text-sm tracking-wider text-primary">
            {t.contact.connect}
          </h3>
          <ul class="space-y-3" role="list">
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/link flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 text-sm text-muted-foreground transition-all hover:border-primary/40 hover:text-foreground"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-primary transition-transform group-hover/link:scale-110"
                    >
                      <path d={iconPaths[link.label]} />
                    </svg>
                    {link.label}
                    <span class="ml-auto font-mono text-xs text-muted-foreground/60">
                      {link.href.replace("https://", "").replace("mailto:", "")}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <p class="text-sm leading-relaxed text-muted-foreground">
            {t.contact.availability}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const success = document.getElementById("contact-success") as HTMLElement;
  const submitBtn = form?.querySelector(
    'button[type="submit"]',
  ) as HTMLButtonElement;
  const originalBtnHTML = submitBtn?.innerHTML;

  const errorMessages: Record<string, string> = {
    FIELDS_REQUIRED: form?.dataset.errorFields || "All fields are required.",
    INVALID_EMAIL: form?.dataset.errorEmail || "Invalid email address.",
    MESSAGE_TOO_LONG: form?.dataset.errorLong || "Message is too long (max 5000 characters).",
    SEND_FAILED: form?.dataset.errorSend || "Failed to send email. Please try again.",
    SERVER_ERROR: form?.dataset.errorServer || "Server configuration error.",
    UNKNOWN: form?.dataset.errorUnknown || "Something went wrong. Please try again.",
  };

  const sendingText = form?.dataset.sendingText || "Sending...";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = Object.fromEntries(new FormData(form));

    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
      </svg>
      ${sendingText}`;

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await res.json();

      if (!res.ok) {
        const code = result.error || "UNKNOWN";
        throw new Error(errorMessages[code] || errorMessages.UNKNOWN);
      }

      form.classList.add("hidden");
      success.classList.remove("hidden");
      success.classList.add("flex");
    } catch (err) {
      alert(
        err instanceof Error ? err.message : errorMessages.UNKNOWN,
      );
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnHTML;
    }
  });
</script>
